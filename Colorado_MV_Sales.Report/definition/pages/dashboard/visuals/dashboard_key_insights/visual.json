                "textRuns": [
                  {
                    "value": "●  Sales rose from $8.97B (FY2008) to $14.51B (FY2015): +61.8%, a 7.1% CAGR despite the -14.6% dip in FY2009.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#C3C2B7",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "●  FY2011 jumped +42.2%, FY2012 corrected -9.9%, then three straight growth years (+9.5%, +11.6%, +8.3%).",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#C3C2B7",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "●  Arapahoe alone is 22.8% of sales and Denver Metro ≈ 62%; Q3 is the strongest quarter (27%), Q1 the weakest (23%).",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#C3C2B7",
